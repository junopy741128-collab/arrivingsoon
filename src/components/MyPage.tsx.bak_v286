import { useState, useEffect } from 'react';
import { Settings, LogOut, ChevronRight, User, Shield, HelpCircle, FileText, Bell, CreditCard, Trash2, Monitor, ShieldCheck, X } from 'lucide-react';
import type { Screen, UserProfile } from '../App';
import { getPointHistory, deletePointHistory } from '../lib/supabaseUtils';
import { ConfirmModal } from './ConfirmModal';
import { AlertModal } from './AlertModal';
import { Dialog, DialogContent, DialogHeader, DialogTitle } from './ui/dialog';

interface MyPageProps {
    onNavigate: (screen: Screen) => void;
    userProfile: UserProfile;
    isAdmin?: boolean;
    onLogout: () => void;
}

export function MyPage({ onNavigate, userProfile, isAdmin, onLogout }: MyPageProps) {
    const [activeTab, setActiveTab] = useState<'all' | 'earned' | 'used'>('all');
    const [pointHistory, setPointHistory] = useState<any[]>([]);
    const [loading, setLoading] = useState(false);
    const [visibleCount, setVisibleCount] = useState(10);

    // [Fix] 임베디드 문서 뷰어 상태 (Capacitor Browser가 HTML을 raw text로 보여주는 문제 해결)
    const [docViewer, setDocViewer] = useState<{ open: boolean; title: string; src: string }>({
        open: false, title: '', src: ''
    });
    const openDoc = (title: string, src: string) => setDocViewer({ open: true, title, src });
    const closeDoc = () => setDocViewer({ open: false, title: '', src: '' });

    // [New] Settings Dialog State
    const [modalState, setModalState] = useState<{ type: 'terms' | 'help' | null }>({ type: null });

    // [New] Delete Handler
    const [confirmState, setConfirmState] = useState<{ isOpen: boolean, id: number | null }>({ isOpen: false, id: null });
    const [alertState, setAlertState] = useState({ open: false, message: '' });

    const handleDeleteClick = (id: number) => {
        setConfirmState({ isOpen: true, id });
    };

    const handleConfirmDelete = async () => {
        if (!confirmState.id) return;
        try {
            await deletePointHistory(confirmState.id);
            setPointHistory(prev => prev.filter(item => item.id !== confirmState.id));
        } catch (e) {
            setAlertState({ open: true, message: "삭제 실패" });
        }
        setConfirmState({ isOpen: false, id: null });
    };

    const handleLoadMore = () => {
        setVisibleCount(prev => prev + 10);
    };

    useEffect(() => {
        const loadHistory = async () => {
            console.log('🔵 [MyPage] 포인트 내역 로딩 시작...');
            const userId = localStorage.getItem('userId');

            if (!userId) {
                console.warn('⚠️ [MyPage] localStorage에 userId 없음 - 로딩 스킵');
                setLoading(false);
                return;
            }

            setLoading(true);

            try {
                const history = await getPointHistory(userId);
                console.log(`✅ [MyPage] 포인트 내역 로드 성공:`, history.length, '건');
                setPointHistory(history);
            } catch (error: any) {
                console.error('❌ [MyPage] 포인트 내역 로드 실패:', error.message);
                setPointHistory([]);
            } finally {
                setLoading(false);
            }
        };

        loadHistory();
    }, [userProfile.email]);

    const filteredHistory = pointHistory.filter(item => {
        if (activeTab === 'all') return true;
        return item.type === activeTab;
    });

    // [New] Purchase Handler
    const handlePurchase = async () => {
        try {
            console.log("💳 [IAP] Initializing Purchase...");
            const { default: OneStore } = await import('../utils/OneStore');
            const { supabase } = await import('../lib/supabaseClient');

            await OneStore.init();

            // Product ID: "premium_monthly_01" (Test ID)
            const result = await OneStore.purchase({
                productId: 'premium_monthly_01',
                productName: '1000 포인트 충전',
                developerPayload: userProfile.email // Pass email for verification context
            });

            console.log("✅ [IAP] Purchase Success:", result);
            setAlertState({ open: true, message: "구매가 완료되었습니다! 처리 중..." });

            // 1. Save Receipt to Supabase
            const { error: receiptError } = await supabase
                .from('payment_receipts')
                .insert({
                    user_id: localStorage.getItem('userId'),
                    order_id: result.orderId,
                    product_id: result.productId,
                    purchase_token: result.purchaseToken,
                    package_name: result.packageName,
                    purchase_time: result.purchaseTime,
                    security_token: result.securityToken,
                    signature: result.signature,
                    original_json: result.originalJson,
                    verified: true
                });

            if (receiptError) {
                console.error("❌ [IAP] Receipt Save Failed:", receiptError);
            }

            // 2. Grant Points
            const { handlePointTransaction } = await import('../lib/supabaseUtils');
            await handlePointTransaction({
                userId: localStorage.getItem('userId') || '',
                amount: 1000,
                type: 'earned',
                description: '포인트 충전 (1,500원)'
            });

            setAlertState({ open: true, message: "1000 포인트가 충전되었습니다! 🎉" });
            onNavigate('mypage'); // Refresh

        } catch (e: any) {
            console.error("❌ [IAP] Purchase Failed:", e);
            setAlertState({ open: true, message: "구매 실패: " + (e.message || "알 수 없는 오류") });
        }
    };

    return (
        <div className="flex flex-col w-full h-full bg-app-primary text-text-primary overflow-hidden">
            {/* --- Header --- */}
            <header className="pt-safe mt-2 px-6 pb-6 bg-app-primary border-b border-border flex items-center gap-4">
                <div className="w-16 h-16 rounded-full bg-app-secondary border-2 border-app-accent flex items-center justify-center overflow-hidden">
                    <User className="w-8 h-8 text-text-muted" />
                </div>
                <div className="flex-1">
                    <h1 className="text-xl font-bold text-white">{userProfile.name}님</h1>
                    <p className="text-sm text-text-muted">{userProfile.email}</p>
                </div>
                <button
                    onClick={() => onNavigate('profile')}
                    className="px-3 py-1.5 rounded-full bg-app-secondary border border-border text-xs text-text-secondary hover:bg-app-tertiary transition-colors"
                >
                    편집
                </button>
            </header>

            {/* --- Content --- */}
            <div className="flex-1 overflow-y-auto pb-32 px-6 pt-6 scrollbar-hide">

                {/* Points Summary */}
                <div className="bg-gradient-to-r from-app-secondary to-app-tertiary rounded-2xl p-6 mb-8 border border-border relative overflow-hidden">
                    <div className="relative z-10">
                        <span className="text-sm text-text-muted">현재 보유 포인트</span>
                        <div className="text-3xl font-bold text-app-accent mt-1">{userProfile?.points?.toLocaleString() || 0} P</div>

                        {/* [New] Purchase Button */}
                        <button
                            onClick={handlePurchase}
                            className="mt-4 px-4 py-2 bg-app-accent text-app-primary text-sm font-bold rounded-lg hover:bg-white transition-colors flex items-center gap-2"
                        >
                            <CreditCard className="w-4 h-4" />
                            포인트 충전 (1,000P / 1,500원)
                        </button>
                    </div>
                    <div className="absolute right-0 top-0 h-full w-1/3 bg-app-accent/5 skew-x-12"></div>
                </div>

                {/* Points Tabs */}
                <div className="mb-6">
                    <h2 className="text-lg font-bold mb-4 flex items-center gap-2">
                        <CreditCard className="w-5 h-5 text-app-accent" />
                        포인트 내역
                    </h2>
                    <div className="flex p-1 bg-app-secondary rounded-xl mb-4">
                        {(['all', 'earned', 'used'] as const).map((tab) => (
                            <button
                                key={tab}
                                onClick={() => setActiveTab(tab)}
                                className={`flex-1 py-2 text-sm font-medium rounded-lg transition-all ${activeTab === tab
                                    ? 'bg-app-accent text-app-primary shadow-sm'
                                    : 'text-text-muted hover:text-white'
                                    }`}
                            >
                                {tab === 'all' ? '전체' : tab === 'earned' ? '충전' : '사용'}
                            </button>
                        ))}
                    </div>

                    <div className="space-y-3">
                        {loading ? (
                            <div className="text-center py-8 text-text-muted text-sm">로딩 중...</div>
                        ) : filteredHistory.length > 0 ? (
                            <>
                                {filteredHistory.slice(0, visibleCount).map((item) => (
                                    <div key={item.id} className="bg-app-secondary border border-border rounded-xl p-4 flex justify-between items-center group relative">
                                        <div className="flex-1 min-w-0 pr-2">
                                            <div className="font-medium text-white mb-0.5 truncate pr-2">
                                                {/* [UI] Truncate Title */}
                                                {item.description}
                                            </div>
                                            <div className="text-xs text-text-muted">
                                                {new Date(item.created_at).toLocaleDateString()}
                                            </div>
                                        </div>
                                        <div className="flex items-center gap-3">
                                            <div className={`font-bold whitespace-nowrap ${item.type === 'earned' ? 'text-status-success' : 'text-status-error'}`}>
                                                {item.type === 'earned' ? '+' : ''}{Math.abs(item.amount).toLocaleString()} P
                                            </div>
                                            {/* [UI] Delete Button */}
                                            <button
                                                onClick={(e) => {
                                                    e.stopPropagation();
                                                    handleDeleteClick(item.id);
                                                }}
                                                className="p-1.5 text-gray-500 hover:text-red-500 hover:bg-gray-700/50 rounded-full transition-colors"
                                            >
                                                <Trash2 className="w-4 h-4" />
                                            </button>
                                        </div>
                                    </div>
                                ))}

                                {/* [UI] Load More Button */}
                                {visibleCount < filteredHistory.length && (
                                    <button
                                        onClick={handleLoadMore}
                                        className="w-full py-3 text-sm text-text-muted hover:text-white bg-app-secondary border border-border rounded-xl transition-colors"
                                    >
                                        더 보기 ({filteredHistory.length - visibleCount}개 남음)
                                    </button>
                                )}
                            </>
                        ) : (
                            <div className="text-center py-8 text-text-muted text-sm">
                                내역이 없습니다.
                            </div>
                        )}
                    </div>
                </div>

                {/* Settings Menu */}
                <div className="mb-8">
                    <h2 className="text-lg font-bold mb-4 flex items-center gap-2">
                        <Settings className="w-5 h-5 text-app-accent" />
                        설정
                    </h2>
                    <div className="bg-app-secondary border border-border rounded-2xl overflow-hidden divide-y divide-border">
                        <MenuItem icon={Bell} label="문자 템플릿 관리 (알림 설정)" onClick={() => onNavigate('messages')} />
                        {(isAdmin || userProfile.email === "junopy741128@gmail.com") && (
                            <MenuItem icon={Shield} label="관리자 페이지" onClick={() => onNavigate('admin')} />
                        )}
                        <MenuItem icon={HelpCircle} label="자주 묻는 질문 (FAQ)" onClick={() => openDoc('자주 묻는 질문', '/faq.html')} />
                        <MenuItem icon={FileText} label="서비스 이용약관" onClick={() => openDoc('서비스 이용약관', '/terms_of_service.html')} />
                        <MenuItem icon={ShieldCheck} label="개인정보 처리방침" onClick={() => openDoc('개인정보 처리방침', '/privacy_policy.html')} />
                        <MenuItem icon={Monitor} label="서비스 및 버전 정보" onClick={() => { }} value="v2.8.0" />
                    </div>
                </div>

                {/* Logout */}
                <button
                    onClick={onLogout}
                    className="w-full py-4 flex items-center justify-center gap-2 text-status-error font-medium hover:bg-status-error-bg rounded-xl transition-colors mb-8"
                >
                    <LogOut className="w-5 h-5" />
                    로그아웃
                </button>

                {/* Company Info */}
                <div className="text-xs text-text-disabled text-center space-y-1 pb-8">
                    <p>(주)올타 | 대표: 정종환</p>
                    <p>사업자등록번호: 680-64-00735</p>
                    <p>문의: junopy@naver.com</p>
                </div>
            </div>

            <ConfirmModal
                isOpen={confirmState.isOpen}
                onClose={() => setConfirmState({ isOpen: false, id: null })}
                onConfirm={handleConfirmDelete}
                title=""
                message={<span className="text-lg font-bold text-[#111111] dark:text-white">이 내역을 삭제하시겠습니까?</span>}
                confirmText="삭제"
                cancelText="취소"
            />

            <AlertModal
                isOpen={alertState.open}
                onClose={() => setAlertState({ ...alertState, open: false })}
                message={alertState.message}
            />

            <Dialog open={modalState.type !== null} onOpenChange={(open) => { if (!open) setModalState({ type: null }) }}>
                <DialogContent className="max-w-[340px] rounded-2xl bg-app-secondary border border-border text-white" aria-describedby={undefined}>
                    <DialogHeader>
                        <DialogTitle className="text-xl font-bold">
                            {modalState.type === 'terms' ? '이용약관' : '도움말'}
                        </DialogTitle>
                    </DialogHeader>
                    <div className="mt-4 space-y-4 text-sm text-text-muted leading-relaxed max-h-[60vh] overflow-y-auto">
                        {modalState.type === 'terms' && (
                            <>
                                <h3 className="text-white font-bold mb-2">제 1 조 (목적)</h3>
                                <p>본 약관은 도착곧(이하 "서비스")의 이용과 관련하여 회사와 회원 간의 권리, 의무 및 책임사항 등을 규정함을 목적으로 합니다.</p>

                                <h3 className="text-white font-bold mt-4 mb-2">제 2 조 (용어의 정의)</h3>
                                <p>① "회원"이란 서비스에 가입하여 본 약관에 따라 회사가 제공하는 서비스를 받는 자를 말합니다.</p>
                                <p>② "문자 알림 서비스"란 사용자가 설정한 도착지 및 경유지에 도달했을 때 지정된 수신자에게 SMS 문자를 자동으로 발송하는 기능을 말합니다.</p>

                                <h3 className="text-white font-bold mt-4 mb-2">제 3 조 (서비스의 제공)</h3>
                                <p>GPS 정보의 수집 및 백그라운드 처리는 알림 서비스 제공의 핵심이며, 오차 범위 내의 정확도를 보장하지는 않습니다.</p>
                            </>
                        )}

                        {modalState.type === 'help' && (
                            <>
                                <h3 className="text-white font-bold mb-2">1. 도착 알림은 어떻게 설정하나요?</h3>
                                <p>홈 화면의 "예약하기" 버튼을 눌러 도착지와 알림을 받을 연락처를 설정하실 수 있습니다.</p>

                                <h3 className="text-white font-bold mt-4 mb-2">2. 문자 내용 수정이 가능한가요?</h3>
                                <p>네, "자주 쓰는 메시지 관리" 또는 마이페이지의 "문자 템플릿 관리"에서 상황에 맞는 메시지를 직접 수정할 수 있습니다.</p>

                                <h3 className="text-white font-bold mt-4 mb-2">3. 문의하기</h3>
                                <p>추가적인 문의사항은 아래 이메일로 연락주시기 바랍니다.</p>
                                <p className="text-[#00ff88] mt-1">junopy@naver.com</p>
                            </>
                        )}
                    </div>
                    <div className="mt-6 flex justify-end">
                        <button
                            onClick={() => setModalState({ type: null })}
                            className="px-6 py-2 bg-app-accent text-app-primary font-bold rounded-xl"
                        >
                            확인
                        </button>
                    </div>
                </DialogContent>
            </Dialog>

            {/* [Fix] 문서 뷰어 모달 - iframe으로 로컬 HTML 정상 렌더링 (안전 영역 대응, 밝은 모드 강제 고정) */}
            {docViewer.open && (
                <div className="fixed inset-0 z-[500] flex flex-col bg-white pt-[env(safe-area-inset-top,20px)] pb-[env(safe-area-inset-bottom,20px)]">
                    {/* 헤더 (밝은 모드 강제) */}
                    <div className="flex items-center justify-between px-4 py-3 border-b border-gray-200 bg-white">
                        <button
                            onClick={closeDoc}
                            className="p-2 -ml-2 text-gray-500 hover:text-black"
                        >
                            <X className="w-6 h-6" />
                        </button>
                        <span className="text-base font-bold text-gray-900">{docViewer.title}</span>
                        <div className="w-10" />
                    </div>
                    {/* iframe - 로컬 HTML 파일 정상 렌더링 (배경 흰색 고정) */}
                    <iframe
                        src={docViewer.src}
                        className="flex-1 w-full border-none bg-white"
                        title={docViewer.title}
                    />
                </div>
            )}
        </div >
    );
}

function MenuItem({ icon: Icon, label, onClick, highlight = false, value }: { icon: any, label: string, onClick: () => void, highlight?: boolean, value?: string }) {
    return (
        <button
            onClick={onClick}
            className="w-full flex items-center justify-between p-4 hover:bg-app-tertiary transition-colors"
        >
            <div className="flex items-center gap-3">
                <Icon className={`w-5 h-5 ${highlight ? 'text-status-error' : 'text-text-secondary'}`} />
                <span className={`text-sm ${highlight ? 'text-status-error font-bold' : 'text-text-primary'}`}>{label}</span>
            </div>
            <div className="flex items-center gap-2">
                {value && <span className="text-sm text-text-muted">{value}</span>}
                <ChevronRight className="w-4 h-4 text-text-disabled" />
            </div>
        </button>
    );
}