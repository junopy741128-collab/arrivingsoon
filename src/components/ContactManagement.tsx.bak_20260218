import { useState, useEffect } from 'react';
import { ArrowLeft, Search, Plus, User, Star, Edit2, Trash2, Check, Users, MoreVertical, Smartphone, UserPlus, Settings } from 'lucide-react';
import { ConfirmModal } from './ConfirmModal';
import { Button } from './ui/button';
import { Input } from './ui/input';
import { Dialog, DialogContent, DialogHeader, DialogTitle } from './ui/dialog';
import type { Screen, Contact } from '../App';
import { AdMob } from '@capacitor-community/admob';
import { Capacitor } from '@capacitor/core';

// [Phase 9] Group Type Definition & Defaults
type ContactGroup = 'none' | 'family' | 'friends' | 'work' | 'vip' | string;

interface ExtendedContact extends Contact {
  group?: ContactGroup;
}

interface GroupDef {
  id: string;
  name: string;
  color: string;
  bgColor: string;
}

// [Phase 9] Default Groups
const DEFAULT_GROUPS: GroupDef[] = [
  { id: 'family', name: '가족', color: 'text-pink-400', bgColor: 'bg-pink-400' },
  { id: 'vip', name: 'VIP', color: 'text-yellow-400', bgColor: 'bg-yellow-400' },
  { id: 'friends', name: '친구', color: 'text-blue-400', bgColor: 'bg-blue-400' },
  { id: 'work', name: '직장', color: 'text-purple-400', bgColor: 'bg-purple-400' },
];

interface ContactManagementProps {
  onNavigate: (screen: Screen) => void;
  onSelectContacts?: (contacts: Contact[]) => void;
  selectionMode?: boolean;
  contacts: Contact[];
  setContacts: (contacts: Contact[]) => void;
  mode?: 'manage' | 'select';
  onContactSelect?: (contact: Contact) => void;
  fromScreen?: Screen;
  initialSelectedContacts?: Contact[];
}

export function ContactManagement({
  onNavigate,
  onSelectContacts,
  selectionMode = false,
  contacts: propContacts,
  setContacts: propSetContacts,
  mode = 'manage',
  onContactSelect,
  fromScreen = 'settings',
  initialSelectedContacts = []
}: ContactManagementProps) {

  // Hide AdMob
  useEffect(() => {
    if (Capacitor.isNativePlatform()) {
      AdMob.hideBanner().catch(err => console.error('Failed to hide banner:', err));
    }
  }, []);

  // Sync Contacts
  const contacts = propContacts as ExtendedContact[];
  const setContacts = (newContacts: Contact[]) => {
    const syncedContacts = newContacts.map(c => {
      const ec = c as ExtendedContact;
      if (ec.group && (!ec.groups || !ec.groups.includes(ec.group))) {
        return { ...ec, groups: [ec.group] };
      }
      return ec;
    });
    propSetContacts(syncedContacts);
  };

  // --- State ---
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedTab, setSelectedTab] = useState<string>('all'); // [Image 2] Tabs
  const [isManageGroupsOpen, setIsManageGroupsOpen] = useState(false); // [Image 3] Manage Screen

  const [isEditDialogOpen, setIsEditDialogOpen] = useState(false);
  const [isAddDialogOpen, setIsAddDialogOpen] = useState(false);
  const [selectedContact, setSelectedContact] = useState<ExtendedContact | null>(null);
  const [selectedContactIds, setSelectedContactIds] = useState<string[]>(initialSelectedContacts.map(c => c.id));
  const [isImportMenuOpen, setIsImportMenuOpen] = useState(false);
  const [isMoreMenuOpen, setIsMoreMenuOpen] = useState<string | null>(null);

  // New Contact State
  const [newContact, setNewContact] = useState<ExtendedContact>({
    id: '', name: '', phone: '', isFavorite: false, type: 'phone', group: 'none', groups: ['none'],
  });

  // [Phase 9] Dynamic Groups State (Persisted in LocalStorage ideally, but for now local state initialized with defaults)
  // For full feature, this should be lifted to App.tsx, but simplified here as requested design implementation.
  const [groups, setGroups] = useState<GroupDef[]>(() => {
    const saved = localStorage.getItem('contact_groups');
    return saved ? JSON.parse(saved) : DEFAULT_GROUPS;
  });

  useEffect(() => {
    localStorage.setItem('contact_groups', JSON.stringify(groups));
  }, [groups]);

  // Filter Logic
  const filteredContacts = contacts.filter(contact => {
    const matchesSearch = contact.name.toLowerCase().includes(searchQuery.toLowerCase()) || contact.phone.includes(searchQuery);
    const matchesGroup = selectedTab === 'all' || contact.group === selectedTab;
    return matchesSearch && matchesGroup;
  });

  // Groups Management Logic
  const handleAddGroup = () => {
    const name = prompt('새 그룹 이름을 입력하세요:');
    if (name) {
      const newGroup: GroupDef = {
        id: `custom_${Date.now()}`,
        name,
        color: 'text-white',
        bgColor: 'bg-gray-400' // Default color for custom
      };
      setGroups([...groups, newGroup]);
    }
  };

  const handleDeleteGroup = (groupId: string) => {
    if (window.confirm('정말 이 그룹을 삭제하시겠습니까?')) {
      setGroups(groups.filter(g => g.id !== groupId));
      // Reset contacts in this group to 'none'
      const updatedContacts = contacts.map(c => c.group === groupId ? { ...c, group: 'none', groups: ['none'] } : c);
      setContacts(updatedContacts);
    }
  };

  const toggleFavorite = (id: string) => {
    setContacts(contacts.map(c =>
      c.id === id ? { ...c, isFavorite: !c.isFavorite } : c
    ));
  };

  const handleImportContacts = async () => {
    setIsImportMenuOpen(false);

    // [V46] Explicitly save current screen to handle OS restart
    localStorage.setItem('currentScreen', mode === 'select' ? 'contacts' : 'contactsManage');
    console.log('💾 [ContactManagement] Saved currentScreen before import:', mode === 'select' ? 'contacts' : 'contactsManage');

    try {
      console.log('📱 연락처 불러오기 시작');

      if (!Capacitor.isNativePlatform()) {
        alert('연락처 기능은 앱에서만 작동합니다.');
        return;
      }

      let ContactsPlugin;
      try {
        const { Contacts } = await import('@capacitor-community/contacts');
        ContactsPlugin = Contacts;
      } catch (importError) {
        console.error("Plugin import failed:", importError);
        alert("연락처 플러그인을 불러올 수 없습니다.");
        return;
      }

      try {
        const result = await ContactsPlugin.pickContact({
          projection: { name: true, phones: true }
        });

        if (!result || !result.contact) {
          console.log("No contact selected");
          return;
        }

        const contact = result.contact;
        const name = contact.name?.display || '이름 없음';
        const phone = contact.phones?.[0]?.number || '';

        if (!phone) {
          alert('전화번호가 없는 연락처입니다.');
          return;
        }

        const normalizedPhone = phone.replace(/-/g, '');
        const isDuplicate = contacts.some(c => c.phone.replace(/-/g, '') === normalizedPhone);

        if (isDuplicate) {
          alert('이미 등록된 번호입니다.');
          return;
        }

        const newContact: ExtendedContact = {
          id: `import-${Date.now()}`,
          name: name,
          phone: phone,
          phoneNumber: normalizedPhone,
          isFavorite: false,
          type: 'phone',
          group: 'none',
          groups: ['none'],
        };

        setContacts([...contacts, newContact]);

      } catch (pickError) {
        console.error("Pick Contact Failed:", pickError);
      }

    } catch (error: any) {
      console.error('Import process failed:', error);
    }
  };

  const handleImportAllContacts = async () => {
    setIsImportMenuOpen(false);
    try {
      console.log('📱 전체 연락처 불러오기 시작');

      if (!Capacitor.isNativePlatform()) {
        alert("이 기능은 앱에서만 사용할 수 있습니다.");
        return;
      }

      const { Contacts } = await import('@capacitor-community/contacts');

      try {
        const permission = await Contacts.requestPermissions();
        if (permission.contacts !== 'granted') {
          alert('연락처 접근 권한이 필요합니다.\n설정에서 권한을 허용해주세요.');
          return;
        }
      } catch (permError) {
        console.error("Permission request failed:", permError);
        alert("권한 요청 중 오류가 발생했습니다.");
        return;
      }

      const result = await Contacts.getContacts({
        projection: {
          name: true,
          phones: true,
        }
      });

      if (!result.contacts || result.contacts.length === 0) {
        alert('저장된 연락처가 없습니다.');
        return;
      }

      let addedCount = 0;
      const newContacts: ExtendedContact[] = [];

      for (const contact of result.contacts) {
        const name = contact.name?.display || '이름 없음';
        const phone = contact.phones?.[0]?.number || '';

        if (phone) {
          const normalizedPhone = phone.replace(/-/g, '');

          const isDuplicate = contacts.some(c => c.phone.replace(/-/g, '') === normalizedPhone) ||
            newContacts.some(c => c.phone.replace(/-/g, '') === normalizedPhone);

          if (!isDuplicate) {
            newContacts.push({
              id: `import-all-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`,
              name: name,
              phone: phone,
              phoneNumber: normalizedPhone,
              isFavorite: false,
              type: 'phone',
              group: 'none',
              groups: ['none']
            });
            addedCount++;
          }
        }
      }

      if (addedCount > 0) {
        setContacts([...contacts, ...newContacts]);
        alert(`${addedCount}명의 연락처를 불러왔습니다.`);
      } else {
        alert('새로 추가할 연락처가 없습니다 (모두 중복됨).');
      }

    } catch (error: any) {
      console.error('❌ 전체 연락처 불러오기 오류:', error);
      alert('전체 연락처 불러오기 중 오류가 발생했습니다: ' + (error.message || JSON.stringify(error)));
    }
  };

  const handleAddNewContact = () => {
    if (!newContact.name || !newContact.phone) {
      alert('이름과 전화번호를 입력해주세요.');
      return;
    }

    const contactToAdd: ExtendedContact = {
      ...newContact,
      id: Date.now().toString() + Math.random(),
      phoneNumber: newContact.phone.replace(/-/g, ''),
      groups: [newContact.group || 'none'],
    };

    setContacts([...contacts, contactToAdd]);
    setIsAddDialogOpen(false);
    setNewContact({
      id: '',
      name: '',
      phone: '',
      isFavorite: false,
      type: 'phone',
      group: 'none',
      groups: ['none'],
    });
  };

  const handleEditContact = () => {
    if (!selectedContact) return;

    const updatedContact = {
      ...selectedContact,
      phoneNumber: selectedContact.phone.replace(/-/g, ''),
      groups: [selectedContact.group || 'none']
    };

    setContacts(contacts.map(c =>
      c.id === selectedContact.id ? updatedContact : c
    ));
    setIsEditDialogOpen(false);
    setSelectedContact(null);
  };

  const handleDeleteContact = (id: string) => {
    const contact = contacts.find(c => c.id === id);
    if (window.confirm(`'${contact?.name}' 연락처를 삭제하시겠습니까?`)) {
      setContacts(contacts.filter(c => c.id !== id));
    }
  };

  const openEditDialog = (contact: ExtendedContact) => {
    setSelectedContact({ ...contact });
    setIsEditDialogOpen(true);
  };

  const openAddDialog = () => {
    setIsImportMenuOpen(false);
    setIsAddDialogOpen(true);
  };

  const updateContactGroup = (contactId: string, group: ContactGroup) => {
    setContacts(contacts.map(c =>
      c.id === contactId ? { ...c, group, groups: [group] } : c
    ));
  };


  // --- Render Helpers ---

  // 1. Group Tabs (Image 2)
  const renderGroupTabs = () => (
    <div className="px-4 pb-4 flex gap-2 overflow-x-auto scrollbar-hide">
      <button
        onClick={() => setSelectedTab('all')}
        className={`px-4 py-2 rounded-full text-sm font-bold whitespace-nowrap transition-colors ${selectedTab === 'all'
          ? 'bg-[#00ff88] text-black'
          : 'bg-[#1a3d32] text-gray-400 hover:text-white'
          }`}
      >
        전체
      </button>
      {groups.map(group => (
        <button
          key={group.id}
          onClick={() => setSelectedTab(group.id)}
          className={`px-4 py-2 rounded-full text-sm font-bold whitespace-nowrap transition-colors ${selectedTab === group.id
            ? 'bg-[#00ff88] text-black'
            : 'bg-[#1a3d32] text-gray-400 hover:text-white'
            }`}
        >
          {group.name}
        </button>
      ))}
    </div>
  );

  // 2. Group Management Screen (Image 3)
  if (isManageGroupsOpen) {
    return (
      <div className="flex flex-col min-h-screen bg-[#0f2920] text-white animate-in slide-in-from-right">
        <header className="pt-safe mt-4 flex items-center px-4 py-4 border-b border-gray-800">
          <button onClick={() => setIsManageGroupsOpen(false)} className="p-2">
            <ArrowLeft className="w-6 h-6" />
          </button>
          <h1 className="flex-1 text-center font-bold text-lg">그룹 관리</h1>
          <div className="w-10"></div>
        </header>

        <div className="p-6 space-y-4">
          {/* Add Group Button */}
          <button
            onClick={handleAddGroup}
            className="w-full h-14 rounded-2xl border border-dashed border-[#00ff88]/50 flex items-center justify-center gap-2 text-[#00ff88] hover:bg-[#00ff88]/10 transition-colors"
          >
            <Plus className="w-5 h-5" />
            <span className="font-bold">그룹 추가</span>
          </button>

          <div className="text-sm text-gray-400 mt-2 mb-1">전체 그룹 ({groups.length})</div>

          {/* Group List */}
          <div className="space-y-3">
            {groups.map(group => (
              <div key={group.id} className="bg-[#1a3d32] rounded-2xl p-4 flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <div className={`w-3 h-3 rounded-full ${group.bgColor}`} />
                  <span className="font-bold text-white">{group.name}</span>
                </div>
                <div className="flex gap-2">
                  <button onClick={() => {
                    const newName = prompt('그룹 이름 수정:', group.name);
                    if (newName) {
                      setGroups(groups.map(g => g.id === group.id ? { ...g, name: newName } : g));
                    }
                  }} className="p-2 text-gray-400 hover:text-white">
                    <Edit2 className="w-4 h-4" />
                  </button>
                  <button onClick={() => handleDeleteGroup(group.id)} className="p-2 text-gray-400 hover:text-red-400">
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Info Box */}
        <div className="px-6 mt-auto mb-6">
          <div className="bg-[#1a3d32]/50 rounded-xl p-4 flex gap-3">
            <div className="mt-1"><Settings className="w-4 h-4 text-gray-400" /></div>
            <p className="text-xs text-gray-400 leading-relaxed">
              도착 알림을 보낼 연락처들을 그룹으로 묶어 관리할 수 있습니다. 각 그룹에는 고유한 색상을 지정하여 구분할 수 있습니다.
            </p>
          </div>
        </div>

        <div className="p-6 pt-0 pb-[calc(1rem+env(safe-area-inset-bottom))]">
          <Button
            onClick={() => setIsManageGroupsOpen(false)}
            className="w-full h-14 bg-[#00ff88] text-[#0f2920] font-bold text-lg rounded-2xl hover:bg-[#00dd77]"
          >
            완료
          </Button>
        </div>
      </div>
    );
  }

  // --- Main Render ---
  return (
    <div className="flex flex-col min-h-screen bg-[#0f2920] text-white">
      <header className="pt-safe mt-4 flex items-center px-4 py-4 border-b border-gray-800 bg-[#0f2920]/95 backdrop-blur-sm sticky top-0 z-50">
        <button onClick={() => onNavigate(mode === 'select' ? fromScreen : 'settings')} className="p-2">
          <ArrowLeft className="w-6 h-6" />
        </button>
        <h1 className="flex-1 text-center font-bold text-lg">연락처 관리</h1>
        <div className="relative">
          {/* Group Manage Button directly in header? Or stick to Import Menu */}
          {/* User requested 'Group Management' screen. Let's put a gear icon or similar for it, or check where Image 3 is accessed from. 
                 It seems to be a separate setting. I'll add a 'FolderCog' or similar icon next to Plus, or inside the Plus menu. 
                 Let's put it next to Plus for visibility as requested by "Image 3: Group Management". */}
        </div>
        <button onClick={() => setIsImportMenuOpen(!isImportMenuOpen)} className="p-2">
          <Plus className="w-6 h-6 text-[#00ff88]" />
        </button>

        {isImportMenuOpen && (
          <>
            <div className="fixed inset-0 z-10" onClick={() => setIsImportMenuOpen(false)} />
            <div className="absolute right-4 top-16 z-20 bg-[#1a3d32] border border-gray-700 rounded-2xl shadow-xl overflow-hidden min-w-[220px] flex flex-col animate-in fade-in zoom-in-95 duration-200">
              <button onClick={() => { setIsImportMenuOpen(false); setIsManageGroupsOpen(true); }} className="w-full px-4 py-3 text-left hover:bg-[#234a3d] flex items-center gap-3 transition-colors">
                <Settings className="w-5 h-5 text-yellow-400" />
                <div><div className="font-medium">그룹 관리</div><div className="text-xs text-gray-400">그룹 추가/수정/삭제</div></div>
              </button>
              <div className="h-px bg-gray-700 mx-4 my-1"></div>
              <button onClick={handleImportContacts} className="w-full px-4 py-3 text-left hover:bg-[#234a3d] flex items-center gap-3 transition-colors">
                <Smartphone className="w-5 h-5 text-[#00ff88]" />
                <div><div className="font-medium">연락처 불러오기</div><div className="text-xs text-gray-400">하나씩 가져오기</div></div>
              </button>
              <button onClick={handleImportAllContacts} className="w-full px-4 py-3 text-left hover:bg-[#234a3d] flex items-center gap-3">
                <Users className="w-5 h-5 text-[#00ff88]" />
                <div><div className="font-medium">전체 가져오기</div><div className="text-xs text-gray-400">한번에 모두 가져오기</div></div>
              </button>
              <button onClick={openAddDialog} className="w-full px-4 py-3 text-left hover:bg-[#234a3d] flex items-center gap-3">
                <UserPlus className="w-5 h-5 text-[#00ff88]" />
                <div><div className="font-medium">직접 입력하기</div><div className="text-xs text-gray-400">이름/번호 입력</div></div>
              </button>
            </div>
          </>
        )}
      </header>

      {/* Search & Tabs */}
      <div className="bg-[#0f2920] sticky top-[73px] z-40 shadow-sm">
        <div className="px-6 py-4">
          <div className="relative">
            <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
            <Input
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="이름 또는 전화번호 검색"
              className="w-full bg-[#1a3d32] border-0 rounded-2xl h-12 pl-12 text-white placeholder:text-gray-500 focus:ring-1 focus:ring-[#00ff88]"
            />
          </div>
        </div>
        {renderGroupTabs()}
      </div>

      {/* List */}
      <div className="flex-1 overflow-y-auto px-6 pb-24">
        {filteredContacts.length === 0 ? (
          <div className="flex flex-col items-center justify-center h-64 text-center text-gray-500">
            <User className="w-12 h-12 mb-3 opacity-50" />
            <p>표시할 연락처가 없습니다.</p>
          </div>
        ) : (
          <div className="space-y-2 mt-2">
            {filteredContacts.map(contact => {
              const group = groups.find(g => g.id === contact.group) || { name: '없음', color: 'text-gray-500', bgColor: 'bg-gray-500' };
              const isSelected = selectedContactIds.includes(contact.id);

              return (
                <div key={contact.id}
                  onClick={() => {
                    if (mode === 'select' || selectionMode) {
                      setSelectedContactIds(prev => prev.includes(contact.id) ? prev.filter(i => i !== contact.id) : [...prev, contact.id]);
                    } else {
                      // toggle more menu or edit
                    }
                  }}
                  className={`bg-[#1a3d32] rounded-2xl p-4 flex items-center gap-3 transition-all active:scale-[0.98] ${isSelected ? 'ring-2 ring-[#00ff88] bg-[#00ff88]/10' : ''}`}
                >
                  {(mode === 'select' || selectionMode) && (
                    <div className={`w-5 h-5 rounded-full border-2 flex items-center justify-center ${isSelected ? 'border-[#00ff88] bg-[#00ff88]' : 'border-gray-500'}`}>
                      {isSelected && <Check className="w-3 h-3 text-[#0f2920]" strokeWidth={4} />}
                    </div>
                  )}
                  <div className="w-10 h-10 rounded-full bg-[#0f2920] flex items-center justify-center border border-gray-700">
                    <span className="font-bold text-gray-300">{contact.name.charAt(0)}</span>
                  </div>
                  <div className="flex-1">
                    <div className="flex items-center gap-2">
                      <span className="font-bold text-white text-base">{contact.name}</span>
                      {contact.group && contact.group !== 'none' && (
                        <span className={`text-[10px] px-1.5 py-0.5 rounded-md font-bold text-black ${group.bgColor.replace('text-', 'bg-').replace('bg-', 'bg-')}`}>
                          {group.name}
                        </span>
                      )}
                    </div>
                    <div className="text-gray-400 text-xs">{contact.phone}</div>
                  </div>

                  {/* More Menu Trigger */}
                  <button onClick={(e) => {
                    e.stopPropagation();
                    setIsMoreMenuOpen(isMoreMenuOpen === contact.id ? null : contact.id);
                  }} className="p-2 text-gray-400 hover:text-white">
                    <MoreVertical className="w-5 h-5" />
                  </button>

                  {/* More Menu Dropdown (Inline) */}
                  {isMoreMenuOpen === contact.id && (
                    <>
                      <div className="fixed inset-0 z-10" onClick={(e) => { e.stopPropagation(); setIsMoreMenuOpen(null); }} />
                      <div className="absolute right-6 mt-8 z-20 bg-[#0f2920] border border-gray-600 rounded-xl shadow-2xl min-w-[160px] overflow-hidden">
                        <div className="px-3 py-2 text-[10px] text-gray-500 font-bold border-b border-gray-700">그룹 변경</div>
                        {groups.map(g => (
                          <button key={g.id} onClick={(e) => {
                            e.stopPropagation();
                            setContacts(contacts.map(c => c.id === contact.id ? { ...c, group: g.id } : c));
                            setIsMoreMenuOpen(null);
                          }} className="w-full text-left px-4 py-2 hover:bg-[#1a3d32] text-xs flex items-center gap-2">
                            <div className={`w-2 h-2 rounded-full ${g.bgColor}`} />
                            <span className="text-gray-300">{g.name}</span>
                            {contact.group === g.id && <Check className="w-3 h-3 text-[#00ff88] ml-auto" />}
                          </button>
                        ))}
                        <div className="h-px bg-gray-700 my-1"></div>
                        <button onClick={(e) => {
                          e.stopPropagation();
                          setSelectedContact(contact);
                          setIsEditDialogOpen(true);
                          setIsMoreMenuOpen(null);
                        }} className="w-full text-left px-4 py-3 hover:bg-[#1a3d32] text-xs text-white">수정하기</button>
                        <button onClick={(e) => {
                          e.stopPropagation();
                          if (window.confirm('삭제하시겠습니까?')) {
                            setContacts(contacts.filter(c => c.id !== contact.id));
                          }
                        }} className="w-full text-left px-4 py-3 hover:bg-[#1a3d32] text-xs text-red-400">삭제하기</button>
                      </div>
                    </>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </div>

      {/* Mode Actions */}
      {selectionMode && mode !== 'select' && (
        <div className="fixed bottom-0 left-0 right-0 bg-[#0f2920] border-t border-gray-800 px-6 py-4 pb-[calc(1rem+env(safe-area-inset-bottom))]">
          <Button
            onClick={() => {
              const selected = contacts.filter(c => selectedContactIds.includes(c.id));
              onSelectContacts?.(selected);
              onNavigate('setup');
            }}
            disabled={selectedContactIds.length === 0}
            className="w-full bg-[#00ff88] hover:bg-[#00dd77] text-[#0f2920] h-14 rounded-2xl font-bold text-lg disabled:opacity-30 disabled:grayscale"
          >
            선택 완료 ({selectedContactIds.length})
          </Button>
        </div>
      )}

      {/* Dialogs Reuse (Add/Edit) */}
      {/* ... Keeping logic simple for Add/Edit as previously implemented, but adapting to new State ... */}
      <Dialog open={isAddDialogOpen} onOpenChange={setIsAddDialogOpen}>
        <DialogContent className="bg-[#1a3d32] border-gray-700 text-white max-w-sm rounded-3xl">
          <DialogHeader><DialogTitle>연락처 추가</DialogTitle></DialogHeader>
          <div className="space-y-4 mt-2">
            <Input value={newContact.name} onChange={e => setNewContact({ ...newContact, name: e.target.value })} placeholder="이름" className="bg-[#0f2920] border-0 h-12 rounded-xl text-white" />
            <Input value={newContact.phone} onChange={e => setNewContact({ ...newContact, phone: e.target.value })} placeholder="전화번호" className="bg-[#0f2920] border-0 h-12 rounded-xl text-white" />
            <div className="flex flex-wrap gap-2">
              {groups.map(g => (
                <button key={g.id} onClick={() => setNewContact({ ...newContact, group: g.id })}
                  className={`px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors ${newContact.group === g.id ? 'border-[#00ff88] text-[#00ff88] bg-[#00ff88]/10' : 'border-gray-600 text-gray-400'}`}>
                  {g.name}
                </button>
              ))}
            </div>
            <Button onClick={() => {
              if (newContact.name && newContact.phone) {
                setContacts([...contacts, { ...newContact, id: Date.now().toString() }]);
                setIsAddDialogOpen(false);
                setNewContact({ id: '', name: '', phone: '', group: 'none', groups: ['none'], isFavorite: false, type: 'phone' });
              }
            }} className="w-full bg-[#00ff88] text-[#0f2920] font-bold h-12 rounded-xl hover:bg-[#00dd77]">저장</Button>
          </div>
        </DialogContent>
      </Dialog>

      <Dialog open={isEditDialogOpen} onOpenChange={setIsEditDialogOpen}>
        <DialogContent className="bg-[#1a3d32] border-gray-700 text-white max-w-sm rounded-3xl">
          <DialogHeader><DialogTitle>연락처 수정</DialogTitle></DialogHeader>
          <div className="space-y-4 mt-2">
            <Input value={selectedContact?.name || ''} onChange={e => setSelectedContact({ ...selectedContact!, name: e.target.value })} placeholder="이름" className="bg-[#0f2920] border-0 h-12 rounded-xl text-white" />
            <Input value={selectedContact?.phone || ''} onChange={e => setSelectedContact({ ...selectedContact!, phone: e.target.value })} placeholder="전화번호" className="bg-[#0f2920] border-0 h-12 rounded-xl text-white" />
            <div className="flex flex-wrap gap-2">
              {groups.map(g => (
                <button key={g.id} onClick={() => setSelectedContact({ ...selectedContact!, group: g.id })}
                  className={`px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors ${selectedContact?.group === g.id ? 'border-[#00ff88] text-[#00ff88] bg-[#00ff88]/10' : 'border-gray-600 text-gray-400'}`}>
                  {g.name}
                </button>
              ))}
            </div>
            <Button onClick={() => {
              if (selectedContact) {
                setContacts(contacts.map(c => c.id === selectedContact.id ? selectedContact : c));
                setIsEditDialogOpen(false);
              }
            }} className="w-full bg-[#00ff88] text-[#0f2920] font-bold h-12 rounded-xl hover:bg-[#00dd77]">수정 완료</Button>
          </div>
        </DialogContent>
      </Dialog>

    </div>
  );
}
