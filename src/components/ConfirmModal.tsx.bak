import React from 'react';
import { Dialog, DialogContent } from './ui/dialog';

interface ConfirmModalProps {
    isOpen: boolean;
    onClose: () => void;
    onConfirm: () => void;
    title: string;
    message: React.ReactNode; // Allow formatted text (e.g. green span)
    confirmText?: string;
    cancelText?: string;
}

export function ConfirmModal({
    isOpen,
    onClose,
    onConfirm,
    title,
    message,
    confirmText = '확인 (OK)',
    cancelText = '취소 (CANCEL)',
}: ConfirmModalProps) {
    return (
        <Dialog open={isOpen} onOpenChange={(open) => !open && onClose()}>
            <DialogContent className="
        max-w-[320px] rounded-[24px] p-0 overflow-hidden 
        bg-white dark:bg-[#1C1C1E] border-none shadow-2xl
        flex flex-col items-center text-center
      ">
                <div className="p-8 pb-6 flex flex-col items-center gap-4 w-full">
                    {/* Title - Bold, Size 18/20 */}
                    <h2 className="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
                        {title}
                    </h2>

                    {/* Message - Size 15/16, Greyish */}
                    <div className="text-[15px] font-medium text-slate-500 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">
                        {message}
                    </div>
                </div>

                {/* Buttons Area */}
                <div className="w-full px-6 pb-6 flex flex-col gap-3">
                    {/* Confirm Button - Green Pill */}
                    <button
                        onClick={onConfirm}
                        className="w-full h-[52px] rounded-2xl bg-[#00FF88] hover:bg-[#00DD77] active:scale-[0.98] transition-all flex items-center justify-center"
                    >
                        <span className="text-[16px] font-bold text-[#0F2920]">
                            {confirmText}
                        </span>
                    </button>

                    {/* Cancel Button - Text Only */}
                    <button
                        onClick={onClose}
                        className="w-full py-2 text-[14px] font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors"
                    >
                        {cancelText}
                    </button>
                </div>
            </DialogContent>
        </Dialog>
    );
}
